{
  "id": "io.dbx.files",
  "name": "Files Studio",
  "description": "A unified file workspace for local folders, S3-compatible storage, Azure Blob, Google Cloud Storage, Huawei OBS, WebDAV, FTP, SFTP, SMB/CIFS, and other OpenDAL services.",
  "publisher": "jinpy",
  "verified": false,
  "icon": "https://raw.githubusercontent.com/jinpy666/dbx-plugin-files/files-v0.1.70/assets/plugin.svg",
  "tags": [
    "files",
    "storage",
    "s3",
    "transfer"
  ],
  "permissions": [
    "host.workbench",
    "host.events",
    "host.binary",
    "host.filesystem"
  ],
  "source": "https://github.com/jinpy666/dbx-plugin-files",
