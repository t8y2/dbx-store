{
  "id": "io.dbx.files",
  "name": "Files Studio",
  "description": "A unified file workspace for local folders, S3-compatible storage, Azure Blob, Google Cloud Storage, Huawei OBS, WebDAV, FTP, SFTP, SMB/CIFS, and other OpenDAL services.",
  "publisher": "jinpy",
  "verified": false,
  "icon": "https://raw.githubusercontent.com/jinpy666/dbx-plugin-files/files-v0.1.79/assets/plugin.svg",
  "tags": [
    "files",
    "storage",
    "s3",
    "transfer"
  ],
  "permissions": [
    "host.binary",
    "host.events",
    "host.filesystem",
    "host.storage",
    "host.workbench"
  ],
  "source": "https://github.com/jinpy666/dbx-plugin-files",
  "homepage": "https://github.com/jinpy666/dbx-plugin-files",
  "license": "MIT",
  "latestVersion": "0.1.79",
  "versions": [
    {
      "version": "0.1.57",
      "releasedAt": "2026-09-15T04:17:29.317Z",
      "releaseNotes": "首个商店版本：统一文件工作台，多协议引擎覆盖本地 fs、S3/MinIO、阿里云 OSS、WebDAV、FTP、SFTP（双栈）、SMB/CIFS；支持浏览、上传下载、复制移动、传输任务（进度/取消/历史）、zip 归档压缩解压、目录同步、presigned 公开链接、只读与删除保护，以及面向自动化的 MCP 工具接口。First store release: unified multi-backend file workspace with transfers, archives, sync, presigned links, read-only/delete guards, and a 12-tool MCP surface.",
