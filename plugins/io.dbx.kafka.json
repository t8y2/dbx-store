{
  "id": "io.dbx.kafka",
  "name": "Kafka Studio",
  "description": "Operate Apache Kafka from one workspace: inspect topics and partitions, produce and consume messages, filter and decode payloads, monitor consumer lag, manage offsets and ACLs, stream records, and export results.",
  "publisher": "jinpy",
  "verified": false,
  "icon": "https://raw.githubusercontent.com/jinpy666/dbx-plugin-kafka/kafka-v0.1.47/assets/plugin.svg",
  "tags": [
    "kafka",
    "streaming",
    "messaging",
    "schema-registry"
  ],
  "permissions": [
    "host.events",
    "host.workbench"
  ],
  "source": "https://github.com/jinpy666/dbx-plugin-kafka",
  "homepage": "https://github.com/jinpy666/dbx-plugin-kafka",
