      "id": "io.dbx.ldap",
      "name": "LDAP Studio",
      "description": "Browse, search, and manage LDAP directories: RFC 4515 filters, directory tree, schema inspection, guarded entry editing, and LDIF/CSV export.",
      "publisher": "jinpy",
      "verified": false,
      "icon": "https://raw.githubusercontent.com/jinpy666/dbx-plugin-ldap/ldap-v0.1.67/assets/plugin.svg",
      "tags": [
        "ldap",
        "directory",
        "auth",
        "enterprise"
      ],
      "permissions": [
        "host.events",
        "host.workbench"
      ],
      "source": "https://github.com/jinpy666/dbx-plugin-ldap/tree/ldap-v0.1.67",
      "homepage": "https://github.com/jinpy666/dbx-plugin-ldap",
